{
  "name": "hermes-g2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hermes Agent on Even Realities G2 glasses",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && evenhub pack app.json dist -o hermes-g2.ehpk --sdk-ver 0.0.15",
    "simulate": "evenhub-simulator http://localhost:5173",
    "qr": "evenhub qr --url",
    "proxy": "node proxy/server.mjs",
    "mock": "node scripts/mock-hermes.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.15",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.20.4",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
