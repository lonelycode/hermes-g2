{
  "name": "hermes-g2",
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "description": "Hermes Agent on Even Realities G2 glasses",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonelycode/hermes-g2.git"
  },
  "bin": {
    "hermes-g2-proxy": "proxy/cli.mjs"
  },
  "files": [
    "proxy/",
    "shared/*.mjs",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && evenhub pack app.json dist -o hermes-g2.ehpk --sdk-ver 0.0.15",
    "simulate": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js",
    "qr": "evenhub qr --url",
    "proxy": "node proxy/cli.mjs run",
    "mock": "node scripts/mock-hermes.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "proxy:setup": "node proxy/cli.mjs setup",
    "pack:check": "npm run build && evenhub pack app.json dist -o hermes-g2.ehpk --sdk-ver 0.0.15 -c",
    "simulate:mock": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js \"http://localhost:5173/?say=what%20changed%20today\"",
    "simulate:chart": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js \"http://localhost:5173/?say=show%20me%20a%20chart%20of%20my%20steps\""
  },
  "devDependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.15",
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@evenrealities/pretext": "^0.1.4",
    "@types/node": "^22.20.4",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
