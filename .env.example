# Two consumers read this file, which is why some names look similar:
#   VITE_*  -> compiled into the glasses/phone app by Vite (only from .env.development.local for
#              `npm run dev`; the phone settings page overrides them at runtime). They describe
#              how the PHONE reaches the proxy/gateway.
#   others  -> read by proxy/server.mjs at startup. They describe how the PROXY reaches Hermes
#              and the STT provider.
# In proxy mode the phone never needs an STT key: leave VITE_STT_KEY empty and set STT_API_KEY.

# --- App defaults (npm run dev only) ---
VITE_HERMES_URL=http://127.0.0.1:8643
VITE_HERMES_KEY=change-me-local-dev
# proxy | elevenlabs | openai | deepgram
VITE_STT_MODE=proxy
VITE_STT_KEY=
VITE_STT_URL=
VITE_STT_MODEL=
# Pin the HMR websocket host when sideloading via QR (your LAN/tailnet IP)
# VITE_HMR_HOST=100.x.y.z

# --- proxy/server.mjs ---
# Use an address the proxy host can actually resolve (a MagicDNS name only works if the proxy
# host is itself on the tailnet).
PORT=8643
HERMES_URL=http://127.0.0.1:8642
# Optional: injected as Authorization if the client sends none
HERMES_API_KEY=
# Optional: clients must present this bearer token to use /stt/transcribe (defaults to HERMES_API_KEY)
PROXY_AUTH_KEY=
# elevenlabs | openai | deepgram
STT_PROVIDER=elevenlabs
STT_API_KEY=
# Optional overrides
STT_URL=
STT_MODEL=
# ISO-639-1 code (en, de, ...), blank = auto-detect
STT_LANGUAGE=
CORS_ORIGIN=*
# Optional: serve a built app (dist/) from the proxy as well
SERVE_DIR=
